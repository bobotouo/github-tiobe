# ========== 必填 ==========
DATABASE_URL=
GITHUB_TOKEN=
# GitHub Actions Secret 不能以 GITHUB_ 开头，线上请建名为 GH_PAT

# ========== 采集（未设置时用代码默认值，见 lib/env-config.ts）==========
DATA_RETENTION_DAYS=30
COLLECT_MAX_REPOS=100
PUSHED_WITHIN_DAYS=30
COLLECT_CONCURRENCY=12

# 新建热度（默认开启；COLLECT_HEAT=0 可关闭）
COLLECT_HEAT=1
COLLECT_HEAT_TOP_LANGS=15
COLLECT_HEAT_LOOKBACK_DAYS=14
COLLECT_HEAT_SEARCH_DELAY_MS=2000

# 独立清理 npm run prune:old-data（默认 40 天，仅 DATABASE_URL）
# PRUNE_RETENTION_DAYS=40

# ========== LLM 归纳（npm run enrich:repos）==========
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5
LLM_TIMEOUT_MS=600000
LLM_JSON_OBJECT_FORMAT=1
LLM_RETRY_MAX=2
LLM_MIN_REQUEST_INTERVAL_MS=500
LLM_429_BACKOFF_BASE_MS=5000
LLM_429_BACKOFF_MAX_MS=80000
ENRICH_MAX_REPOS=20
ENRICH_GITHUB_CONCURRENCY=5
ENRICH_LLM_CONCURRENCY=1

# ========== 可选 ==========
# CRON_SECRET=
# LLM_MODE=json
# LLM_MODE=raw
