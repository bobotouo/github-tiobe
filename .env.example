# ========== 必填 ==========
DATABASE_URL=
GITHUB_TOKEN=
# GitHub Actions Secret 不能以 GITHUB_ 开头，线上请建名为 GH_PAT，workflow 会注入为 GITHUB_TOKEN

# ========== 采集（本地 npm run collect:daily / GitHub Actions）==========
# 快照保留天数（默认 30）；兼容旧名 DB_RETENTION_DAYS。每日采集成功后会删「早于」该窗口的 run。
DATA_RETENTION_DAYS=30

# 独立清理脚本（npm run prune:old-data / GHA）保留的自然日数（含当天），默认 40；仅 DATABASE_URL
# PRUNE_RETENTION_DAYS=40

# 每档样本仓上限（≤1000）；也可用 SAMPLE_MAX_REPOS 作统一别名
COLLECT_MAX_REPOS=100

PUSHED_WITHIN_DAYS=30
COLLECT_CONCURRENCY=12

# 新建仓库 Search 热度（写入 language_heat_snapshots；需 Postgres 已执行含该表的 drizzle/init.sql）
# 历史占比已有、只补热度：见 npm run backfill:heat（勿用 collect:daily --date 补历史，会删当日该档占比重采）
# 按日补缺失：npm run collect:gap -- --from=… --to=… 或 --auto（与 collect:daily 单日逻辑相同）
# COLLECT_HEAT=1
# COLLECT_HEAT_TOP_LANGS=15
# COLLECT_HEAT_LOOKBACK_DAYS=14
# 两次热度 Search 间隔；Search 约 30 次/分钟，默认 2200ms（勿设过小以免 403）
# COLLECT_HEAT_SEARCH_DELAY_MS=2200

# ========== LLM 归纳（npm run enrich:repos，不用可留空 LLM_API_KEY）==========
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=120000
LLM_JSON_OBJECT_FORMAT=1
ENRICH_GITHUB_CONCURRENCY=8
ENRICH_LLM_CONCURRENCY=2
# 每档归纳仓数（默认 20，与 COLLECT_MAX_REPOS 无关；Search 结果按 stars 取前 N）
ENRICH_MAX_REPOS=20

COLLECT_HEAT=1
COLLECT_HEAT_TOP_LANGS=15
COLLECT_HEAT_LOOKBACK_DAYS=14
COLLECT_HEAT_SEARCH_DELAY_MS=2000
